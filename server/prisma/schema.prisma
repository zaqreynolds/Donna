generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Placeholder for a FASTSIGNS center. Clerk Organization will map here later.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  industries       Industry[]
  touchTypes       TouchType[]
  socialPlatforms  SocialPlatform[]
  accounts         Account[]
  contacts         Contact[]
  touches          Touch[]
  accountNotes     AccountNote[]
  contactNotes     ContactNote[]
  accountSocials   AccountSocialLink[]
}

/// Core industry taxonomy used when creating accounts.
model Industry {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Built-in seeded industries cannot be renamed or deleted in Settings.
  isSystem       Boolean  @default(false)
  accounts       Account[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Outreach channel labels used by Touch.type.
model TouchType {
  id             String  @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Built-in seeded touch types cannot be renamed or deleted in Settings.
  isSystem       Boolean @default(false)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([name])
}

/// Platforms available when Touch.type is "Social Media".
model SocialPlatform {
  id             String  @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Built-in seeded platforms cannot be renamed or deleted in Settings.
  isSystem       Boolean @default(false)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([name])
}

/// Primary prospecting target (business, property, school, GC, etc.).
model Account {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  phone          String?
  website        String?
  /// Pipeline / prospecting state (separate from freshness).
  /// Allowed: "NEW" | "CONTACTED" | "QUALIFIED" | "NURTURING" | "LOST"
  status         String    @default("NEW")
  isVip          Boolean   @default(false)
  source         String?
  /// Responsibility only — does not restrict coworker visibility.
  ownerUserId    String?
  createdByUserId String?
  nextTouchAt    DateTime?
  nextTouchType  String?
  nextTouchNote  String?
  industryId     String
  industry       Industry  @relation(fields: [industryId], references: [id], onDelete: Restrict)
  contacts       Contact[]
  notes          AccountNote[]
  socials        AccountSocialLink[]
  touches        Touch[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([industryId])
  @@index([name])
  @@index([isVip])
  @@index([status])
  @@index([ownerUserId])
  @@index([nextTouchAt])
}

model AccountSocialLink {
  id             String  @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform       String
  handle         String

  @@unique([accountId, platform])
  @@index([organizationId])
  @@index([accountId])
  @@index([platform])
}

model AccountNote {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  text           String
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([accountId])
}

/// Person associated with an Account. Secondary to Account prospecting.
model Contact {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  title          String?
  email          String?
  /// Cell / mobile number.
  phone          String?
  /// Office / desk number.
  officePhone    String?
  isVip          Boolean   @default(false)
  source         String?
  touches        Touch[]
  notes          ContactNote[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([accountId])
  @@index([lastName, firstName])
  @@index([email])
  @@index([isVip])
  @@index([createdAt])
}

model ContactNote {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  text           String
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([createdAt])
}

/// Prospecting interaction. Always on an Account; optionally on a Contact.
model Touch {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdByUserId String?
  date            DateTime @default(now())
  /// Outreach channel — must match a TouchType.name (see Settings).
  type            String
  /// Structured outcome (No answer, Voicemail, etc.). Optional.
  outcome         String?
  /// Origin of the touch (manual, apollo, import, etc.).
  source          String?
  /// When true, may later be excluded/weighted in Account freshness.
  isAutomated     Boolean  @default(false)
  notes           String   @default("")
  /// Optional dollar value for Estimate / Sale touches.
  amount          Float?
  estimateNumber  String?
  socialPlatform  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([accountId])
  @@index([contactId])
  @@index([organizationId, date])
  @@index([date])
  @@index([type])
  @@index([outcome])
  @@index([estimateNumber])
  @@index([socialPlatform])
  @@index([isAutomated])
}
